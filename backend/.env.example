# Copy to backend/.env and fill in. Never commit .env.
LLM_PROVIDER=groq
GROQ_API_KEY=
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# LLM_MODEL=            # optional, default: openai/gpt-oss-120b (groq) = model locked in Tahap 12/14
# LLM_MOCK=1            # optional: fake answers for offline testing

# Knowledge base (patch 11)
KB_LAYER=public         # public = safe to deploy | internal = + PNJ RPS/courses, laptop only (= Tahap 12 evaluation)
RAG_COMPARE=1           # 1 = students see "Compare without knowledge base"; 0 = only admins (use 0 during user testing)

# Database (patch 13). Empty = SQLite file careerai.db (laptop). Supabase: Project Settings -> Database ->
# Connection string -> URI, "Session pooler" (port 5432), with your database password. Never commit this line.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
